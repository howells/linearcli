{
  "name": "@howells/linearcli",
  "version": "0.2.1",
  "description": "CLI for Linear — issues, projects, teams, cycles. Agent-first: structured JSON output, schema introspection, input validation, dry-run.",
  "keywords": [
    "agent",
    "ai",
    "cli",
    "issues",
    "linear",
    "project-management"
  ],
  "homepage": "https://github.com/howells/linearcli#readme",
  "license": "MIT",
  "author": "Daniel Howells <daniel.howells@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/howells/linearcli"
  },
  "bin": {
    "linearcli": "./dist/index.js"
  },
  "files": [
    "dist",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "howells-check .",
    "prepublishOnly": "pnpm build",
    "prepare": "howells-husky",
    "lint:fix": "howells-fix .",
    "lint:ratchet": "howells-ratchet",
    "lint:rebaseline": "howells-ratchet --write",
    "prepush": "pnpm typecheck && pnpm lint:ratchet && pnpm test"
  },
  "dependencies": {
    "@howells/cli": "^0.2.0",
    "@linear/sdk": "^95.2.0"
  },
  "devDependencies": {
    "@howells/husky": "^0.2.5",
    "@howells/lint": "^3.5.1",
    "@howells/typescript-config": "^0.1.6",
    "@types/node": "^26.6.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json,jsonc,css,md,mdx}": "howells-oxfmt --write"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.5.2"
}
